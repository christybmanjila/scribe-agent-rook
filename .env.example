# Every setting incident-scribe and its Rook CI use, with where each one goes.
#
#   Running the desk locally: copy this file to .env (git ignores .env) and fill in part 1.
#   Running the Rook CI: part 2 does NOT go in a file. Enter each value either
#     - in GitHub, Settings -> Environments -> rook-assurance, as the secret or variable
#       named below (used by every run, including pull requests), or
#     - in the form under Actions -> Rook assurance -> Run workflow, in the field named after
#       "Run form field:" (that run only; a blank field falls back to the environment).
#   Real environment variables win over .env.
#
# Values here are placeholders. Never commit a real key.

# ---------------------------------------------------------------------------------------
# 1. The desk (incident_scribe) — local .env, and the agent half of the CI
# ---------------------------------------------------------------------------------------

# The desk's shared secret; every command must pass the same value as --token. Preset, so
# nothing to choose. Also export it in your shell (see README). CI uses this same value by
# default; override it with the environment secret SCRIBE_API_TOKEN or the run form field
# scribe_api_token. Rook's profile hands it to the agent.
SCRIBE_API_TOKEN=scribe-demo-token-2026

# The desk's model: the same three settings for any provider.
# CI: variable BASE_URL (Run form field: base_url). Default: https://api.z.ai/api/anthropic
BASE_URL=https://api.z.ai/api/anthropic
# CI: secret LLM_API_KEY (Run form field: llm_api_key).
LLM_API_KEY=
# CI: variable LLM_MODEL (Run form field: llm_model), e.g. GLM-5.3-Flash.
LLM_MODEL=

# Only for an API that is not Anthropic-compatible: gemini, openai (Chat Completions) or
# responses. Blank = Anthropic-compatible (GLM through Z.AI, Anthropic, and others).
# CI: variable LLM_PROVIDER (Run form field: llm_provider).
LLM_PROVIDER=

# Older provider-specific names (ANTHROPIC_BASE_URL, GLM_API_KEY, GLM_MODEL, GEMINI_API_KEY,
# OPENAI_API_KEY, ...) are still read when the three settings above are blank.

# --- Optional tuning (defaults shown) ---
# SCRIBE_STATE_DIR=.scribe-sessions
# OPS_LEARNED_FILE=services/incidents.learned.json
# MCP_TIMEOUT=30
# LLM_TIMEOUT=120
# LLM_RETRIES=1

# ---------------------------------------------------------------------------------------
# 2. Rook CI only — GitHub environment "rook-assurance", or the Run workflow form
# ---------------------------------------------------------------------------------------

# Secrets: your Rook / LambdaTest account (LambdaTest profile -> Account settings ->
# Password & security).
# Environment secret LT_USERNAME · Run form field: lt_username
LT_USERNAME=
# Environment secret LT_ACCESS_KEY · Run form field: lt_access_key
LT_ACCESS_KEY=

# Variables.
# prod or stage. Stage only accepts the LambdaTest VPN, so GitHub-hosted runners need prod.
# Run form field: rook_env
ROOK_ENV=prod
# The ID at the end of the committed folder .testmuai/rook/projects/<slug>--<ID>,
# e.g. 01M45VKSM5VZG8HRBRZ6WT5KRX for incident-scribe-ci.
# Run form field: rook_project_id
ROOK_PROJECT_ID=
# The agent's folder name under that project's agents/.
# Run form field: rook_agent_id
ROOK_AGENT_ID=incident-scribe
# A profile under agents/<agent>/profiles/.
# Run form field: rook_profile
ROOK_PROFILE=local
# Which scenarios run is not a setting. Every committed scenario for the agent is the pool:
# Run workflow -> Scenarios: all, or Scenarios: selected plus their IDs in scenario_ids
# (e.g. SC-001,SC-007). A pull request runs the ones its change touches. Every run's
# summary lists the committed IDs and titles. A ROOK_SCENARIO_IDS variable is not used.
# Optional. Extra tool-call rules for `rook run --allow`, one per line
# (the run form takes a single rule).
# Run form field: rook_allow_rules
ROOK_ALLOW_RULES=
# Optional. Scenarios run at once (default 1).
# Run form field: rook_concurrency
ROOK_CONCURRENCY=1
